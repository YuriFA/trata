{
  "name": "@trata/local-data",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "import": "./src/testing/index.ts"
    }
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate && node scripts/inline-migrations.mjs"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "@trata/api": "workspace:*",
    "@trata/dates": "workspace:*",
    "@trata/money": "workspace:*",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "drizzle-kit": "^0.31.10",
    "typescript": "~6.0.3",
    "vitest": "^4.1.4"
  }
}
