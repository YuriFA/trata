# Example production environment for the VPS stack.
#
# Copy to ~/expense-tracker/.env on the VPS and fill in real values.
# docker-compose.prod.yml interpolates every variable from here; the
# deploy workflow only overrides IMAGE_TAG per deploy.
#
# NEVER commit the real .env (it is git-ignored).

# --- Site ---
# Subdomain the gateway routes to this stack (DNS A record -> VPS IP).
SITE_ADDRESS=expense.example.com

# --- Registry (GHCR) ---
# GHCR repository, lowercase owner/repo. The API image is
# ghcr.io/<GHCR_REPO>, the web image is ghcr.io/<GHCR_REPO>-web.
GHCR_REPO=owner/expense-tracker
# Pull-only credentials: a classic PAT with read:packages for the
# GHCR_USER account. CI pushes with its own token; the VPS only pulls.
GHCR_USER=owner
GHCR_TOKEN=ghp_replace_with_read_packages_pat
# Deployed tag. The deploy workflow passes the real value per deploy
# (sha-<short> on merge, or a pinned sha- tag for rollback); this
# default covers manual `docker compose up -d` on the VPS.
IMAGE_TAG=main

# --- Database ---
POSTGRES_USER=expense
POSTGRES_PASSWORD=replace_with_generated_password
POSTGRES_DB=expense

# --- API ---
# Origin allowlist (CSRF/ADR-0001) — exactly the public site origin.
CORS_ALLOWED_ORIGINS=https://expense.example.com
# Docker bridge subnet the Traefik gateway speaks from, so Gin trusts
# its X-Forwarded-For (client IPs for rate limits) — verify on the VPS:
#   docker network inspect web --format \
#     '{{range .Containers}}{{.Name}} {{.IPv4Address}}{{end}}'
TRUSTED_PROXIES=172.16.0.0/12
# Session cookie over HTTPS only (matches prod.yaml; restated here so
# the deployment file is the single source of runtime truth).
SESSION_SECURE=true

# --- Email (SMTP relay) ---
# Any provider's SMTP endpoint (Resend, SES, Mailgun, Yandex 360, ...).
# Leave SMTP_HOST empty to keep the log-only dev mailer (no email is sent).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Envelope From. A display name works if quoted, e.g.
# "Expense Tracker <noreply@example.com>" (quote any value with spaces:
# this file is sourced by shell scripts too).
SMTP_FROM=noreply@example.com
# starttls (587, default) | implicit (465-style) | none
SMTP_TLS=starttls

# --- Web Push reminders (planned payments) ---
# VAPID key pair (generate anywhere: `npx web-push generate-vapid-keys`).
# Compose interpolates these into the api container; the backend serves the
# PUBLIC key to the web app via GET /api/config/push (nothing in the bundle).
# Both keys empty = push channel disabled: the reminder job does not start
# and the web app hides the reminder opt-in. The private key is secret and
# long-lived: rotating it invalidates every existing subscription.
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_PUBLIC_KEY=
# VAPID JWT subject (mailto: or https: contact, per RFC 8292).
PUSH_VAPID_SUBJECT=mailto:admin@example.com
# Reminder sweep cadence; 1m default.
PUSH_INTERVAL=1m

# --- Backups (backup sidecar) ---
# Nightly dump schedule as cron (UTC). Defaults live in the image
# scripts; override only to change the policy. Quote cron values (spaces).
BACKUP_SCHEDULE="0 3 * * *"
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
# Off-site rclone target, e.g. offsite:expense-tracker — set up once at
# first boot (docs/deployment.md, Backups). Empty = local-only backups
# (each run logs a warning that dumps are not replicated).
RCLONE_REMOTE=
