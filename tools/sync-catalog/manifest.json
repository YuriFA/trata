    {
      "id": "transaction",
      "label": "transaction",
      "goDomainConst": "domain.SyncEntityTransaction",
      "goInvalidDataMessage": "invalid transaction data",
      "webConflictLabelKey": "sync.conflicts.entity.transaction",
      "mobileConflictLabelRu": "Транзакция",
      "subjectFields": [
        "description"
      ],
      "row": {
        "table": "transactions",
        "rowType": "TransactionRow",
        "payloadFields": [
          "amount",
          "description",
          "occurredAt"
        ],
        "payloadVariants": [
          {
            "matches": [
              "transfer"
            ],
            "fields": [
              "fromAccountId",
              "toAccountId",
              "destinationAmount"
            ]
          },
          {
            "matches": [
              "income",
              "expense",
              "adjustment"
            ],
            "fields": [
              "accountId",
              "categoryId"
            ]
          }
        ]
      },
      "syncData": {
        "type": "TransactionSyncData",
        "discriminator": {
          "field": "type",
          "values": [
            "income",
            "expense",
            "transfer",
            "adjustment"
          ]
        },
        "variants": [
          {
            "matches": [
              "transfer"
            ],
            "fields": [
              {
                "name": "amount",
                "kind": "int",
                "required": true,
                "min": 1
              },
              {
                "name": "description",
                "kind": "string",
                "default": ""
              },
              {
                "name": "occurredAt",
                "kind": "string",
                "nonEmpty": true
              },
              {
                "name": "fromAccountId",
                "kind": "string",
                "nonEmpty": true
              },
              {
                "name": "toAccountId",
                "kind": "string",
                "nonEmpty": true
              },
              {
                "name": "destinationAmount",
                "kind": "optionalInt",
                "min": 1
              }
            ]
          },
          {
            "matches": [
              "adjustment"
            ],
            "fields": [
              {
                "name": "amount",
                "kind": "int",
                "required": true,
                "nonzero": true
              },
              {
                "name": "description",
                "kind": "string",
                "default": ""
              },
              {
                "name": "occurredAt",
                "kind": "string",
                "nonEmpty": true
              },
              {
                "name": "accountId",
                "kind": "string",
                "nonEmpty": true
              }
            ]
          },
          {
            "matches": [
              "income",
              "expense"
            ],
            "fields": [
              {
                "name": "amount",
                "kind": "int",
                "required": true,
                "min": 1
              },
              {
                "name": "description",
                "kind": "string",
                "default": ""
              },
              {
                "name": "occurredAt",
                "kind": "string",
                "nonEmpty": true
              },
              {
                "name": "accountId",
                "kind": "string",
                "nullable": true
              },
              {
                "name": "categoryId",
                "kind": "string",
                "nonEmpty": true
              }
            ]
          }
        ]
      },
