          {
            "name": "archivedAt",
            "kind": "optionalString"
          }
        ]
      },
      "restore": {
        "fields": [
          {
            "name": "name",
            "kind": "string",
            "nonEmpty": true
          },
          {
            "name": "type",
            "kind": "enum",
            "values": [
              "income",
              "expense"
            ]
          },
          {
            "name": "icon",
            "kind": "string",
