{
  "entities": [
    {
      "id": "account",
      "label": "account",
      "goDomainConst": "domain.SyncEntityAccount",
      "goInvalidDataMessage": "invalid account data",
      "webConflictLabelKey": "sync.conflicts.entity.account",
      "mobileConflictLabelRu": "Счёт",
      "subjectFields": [
        "name"
      ],
      "row": {
        "table": "accounts",
        "rowType": "AccountRow",
        "payloadFields": [
          "name",
          "currency",
          "openingBalance"
        ]
      },
      "syncData": {
        "type": "AccountSyncData",
        "guard": "data.name",
        "fields": [
          {
            "name": "name",
            "kind": "string",
            "default": ""
          },
          {
            "name": "currency",
            "kind": "enum",
            "values": [
              "USD",
              "EUR",
              "RUB",
              "GBP",
              "CNY",
              "TRY",
              "PLN",
              "GEL",
              "KZT",
              "UAH",
              "AMD",
              "AZN",
              "UZS",
              "KGS",
              "RSD",
              "ILS",
              "AED",
              "THB"
            ]
          },
          {
            "name": "openingBalance",
            "kind": "int",
            "required": true
          }
        ]
      },
      "restore": {
        "fields": [
          {
            "name": "name",
            "kind": "string",
            "nonEmpty": true
          },
          {
            "name": "currency",
            "kind": "enum",
            "values": [
              "USD",
              "EUR",
              "RUB"
            ]
          },
          {
            "name": "openingBalance",
            "kind": "int",
            "default": 0
          }
        ]
      }
    },
