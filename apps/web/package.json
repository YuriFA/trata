{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:watch": "vitest",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:pwa": "playwright test -c playwright.pwa.config.ts",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "lint:design": "vitest run src/__tests__/design-*.test.ts src/__tests__/page-header-rule.test.ts",
    "lint:fsd": "steiger src",
    "i18n:lint": "ESLINT_I18N_STRICT=1 eslint . --cache",
    "format": "oxfmt src/",
    "gen:api": "node scripts/gen-api.mjs"
  },
  "dependencies": {
    "@bprogress/vue": "^1.1.5",
    "@trata/api": "workspace:*",
    "@trata/dates": "workspace:*",
    "@trata/i18n": "workspace:*",
    "@trata/local-data": "workspace:*",
    "@trata/money": "workspace:*",
    "@trata/tokens": "workspace:*",
    "@internationalized/date": "^3.12.1",
    "@lucide/vue": "^1.22.0",
    "@pinia/colada": "^1.3.1",
    "@pinia/colada-plugin-retry": "^1.0.2",
    "@tailwindcss/vite": "^4.2.4",
    "@vee-validate/zod": "^4.15.1",
    "@vueuse/core": "^14.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "comlink": "^4.4.2",
    "drizzle-orm": "^0.45.2",
    "pinia": "^3.0.4",
    "reka-ui": "^2.9.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.32",
    "vue-i18n": "11",
    "vue-router": "^5.0.6",
    "vue-sonner": "^2.0.9",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@feature-sliced/steiger-plugin": "^0.6.0",
    "@intlify/eslint-plugin-vue-i18n": "^4.3.0",
    "@playwright/test": "^1.59.1",
    "@sqlite.org/sqlite-wasm": "3.53.0-build1",
    "@tsconfig/node24": "^24.0.4",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitest/coverage-v8": "^4.1.9",
    "@vitest/eslint-plugin": "^1.6.16",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.60.0",
    "eslint-plugin-playwright": "^2.10.1",
    "eslint-plugin-vue": "~10.8.0",
    "jiti": "^2.6.1",
    "jsdom": "^29.0.2",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.45.0",
    "oxlint": "~1.60.0",
    "steiger": "^0.5.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.0",
    "vite": "^8.0.8",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vitest": "^4.1.4",
    "vue-tsc": "^3.2.6",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
